{
  "name": "repo-city",
  "version": "0.1.0",
  "description": "Your code repository as a miniature city on your real desk, in hands-only mixed reality on Meta Quest 3 (WebXR, IWSDK). A failing test is a building on fire.",
  "license": "MIT",
  "author": "Saurabh Gupta",
  "homepage": "https://github.com/saurabh4269/repo-city#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saurabh4269/repo-city.git"
  },
  "bugs": {
    "url": "https://github.com/saurabh4269/repo-city/issues"
  },
  "keywords": [
    "webxr",
    "meta-quest",
    "quest-3",
    "mixed-reality",
    "hand-tracking",
    "passthrough",
    "iwsdk",
    "threejs",
    "code-visualization",
    "software-visualization",
    "code-city",
    "developer-tools",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "iwsdk adapter sync && iwsdk reference warmup",
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "city": "node tools/repo-to-city/build-all.mjs",
    "test:unit": "node --test tools/test/",
    "test:xr": "XR_LOG_TAG=city python3 tools/e2e/journey.py",
    "test:xr:tour": "XR_LOG_TAG=city python3 tools/e2e/journey.py --tour",
    "city:repo": "node tools/repo-to-city/your-repo.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.1.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
